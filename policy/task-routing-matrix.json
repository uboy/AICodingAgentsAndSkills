{
  "version": 1,
  "response_language": "user_language",
  "profile_order": [
    "repo_change",
    "repo_read",
    "content_task",
    "general"
  ],
  "profiles": {
    "repo_change": {
      "description": "Tracked repository changes: code, scripts, configs, policy, docs.",
      "allow_commit_output": true,
      "non_trivial_flow": "six_step_lifecycle",
      "request_refinement_required": true,
      "delegation_input": "execution_brief",
      "long_task_refresh_required": true,
      "code_execution_mode": "small_isolated_verified_chunks",
      "recommended_agents": [
        "team-lead-orchestrator",
        "agent-architect",
        "lead-dev-planner",
        "implementation-developer",
        "code-review-qa",
        "docs-writer"
      ],
      "recommended_skills": [
        "code-review",
        "security-review",
        "performance-review",
        "agent-system-coach"
      ]
    },
    "repo_read": {
      "description": "Read-only repository analysis, explanation, audit, and review.",
      "allow_commit_output": false,
      "request_refinement_required": true,
      "delegation_input": "execution_brief_when_scope_is_large",
      "long_task_refresh_required": true,
      "context_mode": "narrow_scope_progressive_discovery",
      "recommended_agents": [
        "team-lead-orchestrator"
      ],
      "recommended_skills": [
        "code-review",
        "security-review",
        "performance-review",
        "build-system-analysis",
        "large-codebase-context",
        "agent-system-coach"
      ]
    },
    "content_task": {
      "description": "Homework, source analysis, transcript processing, text editing, and other content-first work.",
      "allow_commit_output": false,
      "request_refinement_required": true,
      "delegation_input": "execution_brief",
      "long_task_refresh_required": true,
      "source_prep_decision_in_brief": true,
      "multi_step_contract": [
        "execution_brief",
        "execution_plan",
        "answer_plan",
        "sequential_small_steps"
      ],
      "recommended_agents": [
        "team-lead-orchestrator",
        "homework-manager",
        "text-editor"
      ],
      "recommended_skills": [
        "case-analyzer",
        "homework-management",
        "text-humanize",
        "text-cleanup",
        "lecture-transcript",
        "meeting-notes",
        "task-progress",
        "task-specifier",
        "openharmony-task-specifier"
      ]
    },
    "general": {
      "description": "Questions about policy, behavior, process, or lightweight discussion without repository edits.",
      "allow_commit_output": false,
      "recommended_agents": [
        "team-lead-orchestrator"
      ],
      "recommended_skills": [
        "agent-system-coach"
      ]
    }
  },
  "execution_brief_contract": {
    "required": true,
    "policy_path": "policy/execution-brief-contract.md",
    "template_path": "coordination/templates/execution-brief.json",
    "required_fields": [
      "task_profile",
      "task_shape",
      "refined_objective",
      "user_intent",
      "output_expectation",
      "hard_constraints",
      "forbidden_assumptions",
      "relevant_sources",
      "source_prep_recommendation",
      "active_rules",
      "subtask_boundary",
      "success_criteria",
      "verification_requirements",
      "chunking_requirement",
      "long_task_refresh"
    ],
    "refresh_triggers": [
      "before_delegation",
      "after_each_verified_chunk",
      "after_scope_change",
      "after_blocker_or_failed_verification",
      "before_resume_after_pause"
    ],
    "code_chunking_defaults": {
      "mode": "small_isolated_verified_chunks",
      "primary_file_scope_target": 3,
      "verify_between_chunks": true,
      "expand_scope_only_if_blocked": true
    }
  },
  "commit_output_gate": {
    "required": [
      "tracked_repo_diff_exists",
      "verification_passed",
      "no_secret_blockers",
      "no_scope_blockers",
      "no_failed_gates",
      "change_is_ready_to_commit"
    ]
  }
}
