{
  "contextFileName": ["GEMINI.md"],
  "ui": {
    "footer": {
      "items": [
        {
          "type": "text",
          "content": "Agents: ",
          "command": "/agents"
        }
      ]
    }
  },
  "extensions": {
    "manifestUrl": ".gemini/extensions/ai-coding-agents/manifest.json"
  },
  "hooks": {
    "PreCompress": "pwsh -NoProfile -File .gemini/hooks/pre-compress.ps1",
    "PreCompact": "pwsh -NoProfile -File .gemini/hooks/PreCompact.ps1",
    "SaveSessionState": "pwsh -NoProfile -File .gemini/hooks/save-session-state.ps1",
    "SessionStart": "pwsh -NoProfile -File .gemini/hooks/session-start.ps1"
  },
  "settings": {
    "compact": {
      "enabled": true,
      "threshold": 0.2
    }
  }
}